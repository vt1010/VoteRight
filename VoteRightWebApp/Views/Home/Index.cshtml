            <!-- About Section -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3 text-primary">About VoteRight</h3>
                    <p>VoteRight is designed to simplify the process of managing election data, finding volunteers, and securely downloading filtered CSV reports. Our platform leverages AWS S3 for reliable and scalable file storage.</p>
                </div>
            </div>

            <!-- Features Section -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3 text-primary">Key Features</h3>
                    <ul class="list-unstyled mb-0">
                        <li><i class="bi bi-check-circle text-success me-2"></i> Secure authentication and user management</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i> Easy CSV filtering and download</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i> Volunteer search and management</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i> Responsive design for all devices</li>
                    </ul>
                </div>
            </div>

            <!-- Quick Links Section -->
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h3 class="h5 mb-3 text-primary">Quick Links</h3>
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item"><a href="@Url.Action("FindVolunteers", "Home")" class="btn btn-link">Find Volunteers</a></li>
                        <li class="list-inline-item"><a href="@Url.Action("EducativeVideos", "Home")" class="btn btn-link">Educative Videos</a></li>
                        <li class="list-inline-item"><a href="@Url.Action("Faq", "Home")" class="btn btn-link">FAQ</a></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

