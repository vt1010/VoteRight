@{
    ViewData["Title"] = "Welcome to VoteRight";
}

<div class="container mt-4">
    <div class="row min-vh-100 align-items-center">
        <div class="col-lg-6 mx-auto">
            <div class="text-center mb-5">
                <h1 class="display-3 fw-bold text-primary mb-3">VoteRight</h1>
                <p class="lead text-muted mb-4">A secure, efficient, and user-friendly platform for managing election data, volunteers, and CSV downloads from AWS S3.</p>
                <p class="text-secondary">Download reports efficiently</p>
            </div>

