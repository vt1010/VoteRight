@{
    ViewData["Title"] = "Vote Chori Videos";
}

<div class="container mt-4">
    <h1 class="mb-4">Vote Chori Videos</h1>
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Understanding Vote Chori</h5>
                    <div class="ratio ratio-16x9 mb-2">
                        <iframe src="https://www.youtube.com/embed/1y_kfWUCFDQ" title="Understanding Vote Chori" allowfullscreen></iframe>
                    </div>
                    <p class="card-text">Learn about the concept of Vote Chori and how to prevent it during elections.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Real-life Examples of Vote Chori</h5>
                    <div class="ratio ratio-16x9 mb-2">
                        <iframe src="https://www.youtube.com/embed/2Vv-BfVoq4g" title="Real-life Examples of Vote Chori" allowfullscreen></iframe>
                    </div>
                    <p class="card-text">Watch real-life scenarios and case studies related to Vote Chori.</p>
                </div>
            </div>
        </div>
    </div>
</div>
