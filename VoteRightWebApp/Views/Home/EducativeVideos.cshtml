@{
    ViewData["Title"] = "Educative Videos";
}

<div class="container mt-4">
    <h1 class="mb-4">Educative Videos</h1>
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">How to Use VoteRight</h5>
                    <div class="ratio ratio-16x9 mb-2">
                        <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="How to Use VoteRight" allowfullscreen></iframe>
                    </div>
                    <p class="card-text">A step-by-step guide to using the VoteRight platform for CSV downloads and volunteer management.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">AWS S3 Integration Explained</h5>
                    <div class="ratio ratio-16x9 mb-2">
                        <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="AWS S3 Integration" allowfullscreen></iframe>
                    </div>
                    <p class="card-text">Learn how VoteRight integrates with AWS S3 for secure and scalable file storage.</p>
                </div>
            </div>
        </div>
    </div>
</div>
