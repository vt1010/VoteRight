{
  "ConnectionStrings": {
    "PostgresConnection": "Host=your-rds-endpoint.amazonaws.com;Port=5432;Database=voteright;Username=your_user;Password=your_password;Ssl Mode=Require;Trust Server Certificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "Logs/app-.txt",
      "RetainedFileCountLimit": 10,
      "FileSizeLimitBytes": 10485760
    }
  },
  "AllowedHosts": "*"  
}
